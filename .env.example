# Banco de dados
DB_NAME=nexusit
DB_USER=nexusit
DB_PASSWORD=troque_esta_senha

# JWT — gere com: openssl rand -hex 32
JWT_SECRET=troque_por_um_segredo_de_pelo_menos_32_caracteres_aqui_000000000000
JWT_EXPIRATION=28800000

# Cofre/Console SSH/NexusDesk — chave de criptografia AES (32 bytes). Gere com: openssl rand -base64 32
# Se essa variavel nao estiver definida, o backend cai num valor padrao fixo no codigo-fonte
# (inseguro em producao) — sempre confirme que esta setada antes de ir pra producao.
VAULT_ENCRYPTION_KEY=troque_por_uma_chave_de_32_bytes_gerada_com_openssl

# Zabbix
ZABBIX_API_URL=http://IP_DO_ZABBIX/api_jsonrpc.php
ZABBIX_USER=admin
ZABBIX_PASSWORD=

# GLPI
GLPI_API_URL=http://IP_DO_GLPI/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# NexusUpdater — servico auxiliar que verifica/aplica atualizacoes (botao "Atualizar" no sistema)
# UPDATER_TOKEN: gere com: openssl rand -hex 32 (tem que ser o mesmo valor usado pelo backend e pelo nexusupdater)
# NEXUSIT_REPO_PATH: caminho ABSOLUTO onde este repositorio esta clonado NO SERVIDOR (mesma pasta do docker-compose.yml)
UPDATER_TOKEN=troque_por_um_token_gerado_com_openssl
NEXUSIT_REPO_PATH=/opt/nexusit
